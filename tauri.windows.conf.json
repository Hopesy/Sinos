{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Sinos CLI",
        "label": "main",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "preventOverflow": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "resources": {
      "THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/windows/conpty/conpty.dll": "conpty.dll",
      "resources/windows/conpty/OpenConsole.exe": "OpenConsole.exe",
      "resources/windows/conpty/LICENSE.txt": "CONPTY-LICENSE.txt"
    }
  }
}
