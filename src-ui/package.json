{
  "name": "sinos-cli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:android": "tsc -b && vite build --config vite.android.config.ts && cap sync android",
    "android:apk": "node scripts/android-build.mjs debug",
    "android:release": "node scripts/android-build.mjs release",
    "android:setup-signing": "node scripts/android-signing.mjs",
    "android:open": "cap open android",
    "build:phone": "tsc -b && vite build --config vite.phone.config.ts",
    "dev:phone": "vite --config vite.phone.config.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
